rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /Users/{userId} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId;

      match /appointments/{appointmentId} {
        allow read, write: if request.auth != null
          && request.auth.uid == userId;
      }
    }

    match /Doctors/{doc} {
      allow read: if request.auth != null;
      allow write: if false;
    }


    match /{path=**}/appointments/{appointmentId} {
      function isAssignedDoctor() {
        return request.auth != null
          && resource.data.doctorId is string
          && get(
            /databases/$(database)/documents/Doctors/$(resource.data.doctorId)
          ).data.authUid == request.auth.uid;
      }

      allow read: if isAssignedDoctor();

      allow update: if isAssignedDoctor()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'principalDisease',
          'medicalReport',
          'status',
          'completedAt'
        ])
        && request.resource.data.status == 'completed'
        && request.resource.data.principalDisease is string
        && request.resource.data.principalDisease.size() > 0
        && request.resource.data.medicalReport is string
        && request.resource.data.medicalReport.size() > 0
        && request.resource.data.medicalReport.size() <= 20000;
    }
    match /Slots/{slotId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;

      function isAssignedDoctor() {
        return request.auth != null
          && resource.data.doctorId is string
          && get(
            /databases/$(database)/documents/Doctors/$(resource.data.doctorId)
          ).data.authUid == request.auth.uid;
      }

      allow update: if isAssignedDoctor()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'principalDisease',
          'medicalReport',
          'status',
          'completedAt'
        ])
        && request.resource.data.status == 'completed'
        && request.resource.data.principalDisease is string
        && request.resource.data.principalDisease.size() > 0
        && request.resource.data.medicalReport is string
        && request.resource.data.medicalReport.size() > 0
        && request.resource.data.medicalReport.size() <= 20000;

      allow delete: if false;
    }
  }
}
