rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /Users/{userId} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId;

      match /appointments/{appointmentId} {
        allow read, write: if request.auth != null
          && request.auth.uid == userId;
      }
    }

    match /Doctors/{doc} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /{path=**}/appointments/{appointmentId} {
      function isAssignedDoctor() {
        return request.auth != null
          && resource.data.doctorId is string
          && get(
            /databases/$(database)/documents/Doctors/$(resource.data.doctorId)
          ).data.authUid == request.auth.uid;
      }

      function patientHasCheckedIn() {
        return resource.data.slotId is string
          && get(
            /databases/$(database)/documents/Slots/$(resource.data.slotId)
          ).data.status == 'checkedIn';
      }
      allow read: if isAssignedDoctor();

      allow update: if isAssignedDoctor()
        && patientHasCheckedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'principalDisease',
          'medicalReport',
          'status',
          'completedAt'
        ])
        && request.resource.data.status == 'completed'
        && request.resource.data.principalDisease is string
        && request.resource.data.principalDisease.size() > 0
        && request.resource.data.medicalReport is string
        && request.resource.data.medicalReport.size() > 0
        && request.resource.data.medicalReport.size() <= 20000;
    }

    match /Slots/{slotId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;

      // El paciente puede hacer check-in en su propio slot.
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && resource.data.status == 'scheduled'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'checkInAt'])
        && request.resource.data.status == 'checkedIn';

      // El médico asignado puede cerrar la cita y guardar su informe en el slot.
      allow update: if request.auth != null
        && resource.data.doctorId is string
        && get(
          /databases/$(database)/documents/Doctors/$(resource.data.doctorId)
        ).data.authUid == request.auth.uid
        && resource.data.status in ['scheduled', 'checkedIn']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'principalDisease',
          'medicalReport',
          'status',
          'completedAt'
        ])
        && request.resource.data.status == 'completed'
        && request.resource.data.principalDisease is string
        && request.resource.data.principalDisease.size() > 0
        && request.resource.data.principalDisease.size() <= 300
        && request.resource.data.medicalReport is string
        && request.resource.data.medicalReport.size() > 0
        && request.resource.data.medicalReport.size() <= 20000
        && request.resource.data.completedAt == request.time;

      allow delete: if request.auth != null
        && resource.data.uid == request.auth.uid;
    }

    // Turnos: solo se crea o incrementa al confirmar un check-in válido.
match /Queues/{queueId} {
      allow read: if request.auth != null;

      function validCheckIn() {
        let slotPath = /databases/$(database)/documents/Slots/$(request.resource.data.lastSlotId);
        
        // CORRECCIÓN: Usamos un comodín o buscamos la cita de forma que no dependa 
        // de hardcodear request.auth.uid si la ruta puede variar, 
        // o asegurándonos de que pertenezca al usuario autenticado actual.
        let appointmentPath = /databases/$(database)/documents/Users/$(request.auth.uid)/appointments/$(request.resource.data.lastAppointmentId);

        return request.auth != null
          && request.resource.data.lastSlotId is string
          && request.resource.data.lastAppointmentId is string
          && existsAfter(slotPath)
          && existsAfter(appointmentPath)
          && getAfter(slotPath).data.uid == request.auth.uid
          && getAfter(slotPath).data.status == 'checkedIn'
          && getAfter(slotPath).data.doctorId == request.resource.data.doctorId
          && getAfter(slotPath).data.dateKey == request.resource.data.dateKey
          && getAfter(appointmentPath).data.status == 'checkedIn'
          && getAfter(appointmentPath).data.queueNumber == request.resource.data.lastNumber
          && getAfter(appointmentPath).data.doctorId == request.resource.data.doctorId;
      }

      allow create: if validCheckIn()
        && request.resource.data.keys().hasOnly([
          'doctorId',
          'centerCode',
          'dateKey',
          'lastNumber',
          'lastSlotId',
          'lastAppointmentId'
        ])
        && request.resource.data.keys().hasAll([
          'doctorId',
          'centerCode',
          'dateKey',
          'lastNumber',
          'lastSlotId',
          'lastAppointmentId'
        ])
        && request.resource.data.lastNumber == 1;

      allow update: if validCheckIn()
        && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly(['lastNumber', 'lastSlotId', 'lastAppointmentId'])
        && request.resource.data.lastNumber == resource.data.lastNumber + 1;
    }

    // Sesiones (sala / horario por médico-centro-día). Escribe solo el admin.
    match /Sessions/{sessionId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
